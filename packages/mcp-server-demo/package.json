{
  "name": "@ai-chat/mcp-server-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Demo Streamable HTTP MCP server for local development and agent tests.",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "node --watch src/bin/http.ts",
    "start": "node src/bin/http.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.2"
  }
}
