HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
SYSTEM_PROMPT= # overrides packages/agents/src/system-prompt.md
MODEL_PROVIDER=openai # "openai" | "openai-compatible" | "anthropic" | "google"
MODEL_API_KEY=
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API=chat # "responses" | "chat"; OpenAI providers only
MODEL_HEADERS= # JSON object of extra request headers, e.g. '{"x-cobo-data-class":"C"}'
AGENT_MAX_TOOL_ITERATIONS=4
# demo: packages/mcp-server-demo, started by `pnpm dev` (a url defaults to Streamable HTTP)
MCP_SERVERS='{"demo":{"url":"http://127.0.0.1:3901/mcp"}}'
MCP_OAUTH_REDIRECT_URL= # defaults to http://localhost:$PORT/mcp/oauth/callback
