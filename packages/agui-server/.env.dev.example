# Non-secret dev settings mirrored from .env. Copy to .env and fill in MODEL_API_KEY; defaults live in src/config.ts.
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info # "debug" also logs full prompts and tool results
SESSION_SECRET= # signs the session cookie; empty → generated once into .session-secret
SYSTEM_PROMPT= # empty → packages/agents/src/system-prompt.md
MODEL_PROVIDER=openai-compatible # "openai" | "openai-compatible" | "anthropic" | "google"; empty → "openai-compatible" when MODEL_BASE_URL is set, else "openai"
MODEL_API_KEY= # required
MODEL_NAME=gpt-6.1-sol # required
MODEL_BASE_URL=https://api-llm-gateway.1cobo.com # required for openai-compatible
MODEL_CONTEXT_WINDOW= # tokens; compaction starts at 80% of it
MODEL_API=responses # "responses" | "chat"; OpenAI providers only (openai-compatible gateways often need "chat")
MODEL_HEADERS='{"x-cobo-data-class":"C"}' # JSON object of extra request headers, e.g. '{"x-cobo-data-class":"C"}'
AGENT_MAX_TOOL_ITERATIONS=4 # rounds of tool calls per run, then one tools-off turn to answer
AGENT_CODE_MODE=off # "on": the model calls builtin/MCP tools by writing TypeScript for one sandboxed execute_code tool
AGENT_CODE_MODE_TIMEOUT_MS=30000 # per execute_code call, tool calls included
AGENT_CODE_MODE_TOOL_DISCOVERY=auto # "on": prompt lists tool names only, the model looks declarations up with search_tools; "off": all declarations inline; "auto": inline while short
AGENT_DEBUG_EVENTS=on # "on": stream every model call (system prompt, messages, tools, response) to the frontend's Debug panel; exposes full prompts to the browser
# demo: packages/mcp-server-demo, started by `pnpm dev` (a url defaults to Streamable HTTP)
MCP_SERVERS='{"demo":{"url":"http://127.0.0.1:3901/mcp"}}'
MCP_OAUTH_REDIRECT_URL= # empty → http://localhost:$PORT/mcp/oauth/callback
MCP_OAUTH_STORE_PATH=.mcp-oauth.json # MCP OAuth tokens file (plain text, mode 0600); "off" keeps them in memory
SKILLS_DIRS= # comma-separated Agent Skills directories, an earlier one winning a name clash; "off" disables skills. empty → packages/skills
