{
  "name": "@ai-chat/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AG-UI agent runner: a framework-free agentic loop over @ai-sdk models.",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "compile": "tsc -p tsconfig.json",
    "copy:prompt": "mkdir -p dist && cp src/system-prompt.md dist/",
    "copy:skills": "mkdir -p dist/skills && find src/skills -mindepth 1 -maxdepth 1 -type d -exec cp -R {} dist/skills/ ';'",
    "copy:assets": "npm run copy:prompt && npm run copy:skills",
    "build": "npm run clean && npm run compile && npm run copy:assets",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@a2ui/web_core": "^0.10.0",
    "@ag-ui/core": "0.0.53",
    "@ai-sdk/anthropic": "^2.0.79",
    "@ai-sdk/google": "^2.0.74",
    "@ai-sdk/openai": "^3.0.66",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "quickjs-emscripten-core": "0.32.0",
    "rxjs": "7.8.1",
    "tiktoken": "^1.0.22",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-chat/mcp-server-demo": "workspace:*",
    "@types/node": "^24.0.0"
  }
}
